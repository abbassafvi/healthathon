        "type": "object",
        "required": [
          "id",
          "analyte_code",
          "analyte_name",
          "value_text",
          "unit_text",
          "observed_at"
        ],
        "title": "RecordValue",
        "description": "A renderable value, exactly as printed. Nothing derived is attached."
      },
      "Trace": {
        "properties": {
          "value": {
            "$ref": "#/components/schemas/RecordValue"
          },
          "patient": {
            "$ref": "#/components/schemas/PatientSummary"
          },
          "document": {
            "$ref": "#/components/schemas/DocumentInfo"
