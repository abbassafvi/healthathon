      },
      "QueueDocument": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "doc_type": {
            "type": "string",
            "title": "Doc Type"
          },
          "document_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Date"
          }
        },
        "type": "object",
        "required": [
          "id",
          "doc_type",
          "document_date"
        ],
        "title": "QueueDocument"
      },
