  "components": {
    "schemas": {
      "Box": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "w": {
            "type": "number",
            "title": "W"
          },
          "h": {
            "type": "number",
            "title": "H"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "title": "Box",
        "description": "Normalised 0..1 region on the page, as core.provenance stores it."
      },
      "CandidateReading": {
        "properties": {
          "value_text": {
            "type": "string",
            "title": "Value Text"
          },
          "unit_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Text"
          }
        },
        "type": "object",
        "required": [
          "value_text"
        ],
        "title": "CandidateReading"
      },
      "CurrentUser": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "full_name",
          "role"
        ],
        "title": "CurrentUser"
      },
      "Decision": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "confirm",
              "correct",
              "discard"
            ],
            "title": "Action"
          },
          "decision_latency_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Decision Latency Ms"
          },
          "value_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Text"
          },
          "unit_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Text"
          }
        },
        "type": "object",
        "required": [
          "action",
          "decision_latency_ms"
        ],
        "title": "Decision",
        "description": "What a reviewer decided about one item.\n\ndecision_latency_ms runs from the moment the crop finished rendering to\nthe decision. The client cannot send a decision before that moment."
      },
      "DecisionResult": {
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid",
            "title": "Item Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "value_id": {
            "type": "string",
            "format": "uuid",
            "title": "Value Id"
          },
          "replacement_value_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replacement Value Id"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "action",
          "value_id",
          "replacement_value_id"
        ],
        "title": "DecisionResult"
      },
      "DocumentInfo": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "doc_type": {
            "type": "string",
            "title": "Doc Type"
          },
          "document_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Date"
          },
          "issuing_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issuing Source"
          }
        },
        "type": "object",
        "required": [
          "id",
          "doc_type",
          "document_date",
          "issuing_source"
        ],
        "title": "DocumentInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PatientRecord": {
        "properties": {
          "patient": {
            "$ref": "#/components/schemas/PatientSummary"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/RecordDocument"
            },
            "type": "array",
            "title": "Documents"
          }
        },
        "type": "object",
        "required": [
          "patient",
          "documents"
        ],
        "title": "PatientRecord"
      },
