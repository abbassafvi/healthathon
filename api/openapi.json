              {
                "type": "null"
              }
            ],
            "title": "Year Of Birth"
          },
          "sex": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sex"
          }
        },
        "type": "object",
        "required": [
          "id",
          "registration_no",
          "full_name",
          "year_of_birth",
          "sex"
