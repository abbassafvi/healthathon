        "title": "RecordDocument"
      },
      "RecordValue": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "analyte_code": {
            "type": "string",
            "title": "Analyte Code"
          },
          "analyte_name": {
            "type": "string",
            "title": "Analyte Name"
          },
          "value_text": {
            "type": "string",
            "title": "Value Text"
          },
          "unit_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Text"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
