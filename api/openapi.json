{
  "openapi": "3.1.0",
  "info": {
    "title": "Healthathon API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/confirm-queue": {
      "get": {
        "tags": [
          "confirm-queue"
        ],
        "summary": "List Queue",
        "operationId": "list_queue_api_confirm_queue_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/confirm-queue/{item_id}/decision": {
      "post": {
        "tags": [
          "confirm-queue"
        ],
        "summary": "Post Decision",
        "operationId": "post_decision_api_confirm_queue__item_id__decision_post",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Item Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Me",
        "operationId": "me_api_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/{key}": {
      "get": {
        "tags": [
          "storage"
        ],
        "summary": "Get Stored File",
        "operationId": "get_stored_file_api_storage__key__get",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CandidateReading": {
        "properties": {
          "value_text": {
            "type": "string",
            "title": "Value Text"
          },
          "unit_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Text"
          }
        },
        "type": "object",
        "required": [
          "value_text"
        ],
        "title": "CandidateReading"
      },
      "CurrentUser": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "full_name",
          "role"
        ],
        "title": "CurrentUser"
      },
      "Decision": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "confirm",
              "correct",
              "discard"
            ],
            "title": "Action"
          },
          "decision_latency_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Decision Latency Ms"
          },
          "value_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Text"
          },
          "unit_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Text"
          }
        },
        "type": "object",
        "required": [
          "action",
          "decision_latency_ms"
        ],
        "title": "Decision",
        "description": "What a reviewer decided about one item.\n\ndecision_latency_ms runs from the moment the crop finished rendering to\nthe decision. The client cannot send a decision before that moment."
      },
      "DecisionResult": {
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid",
            "title": "Item Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "value_id": {
            "type": "string",
            "format": "uuid",
            "title": "Value Id"
          },
          "replacement_value_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replacement Value Id"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "action",
          "value_id",
          "replacement_value_id"
        ],
        "title": "DecisionResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QueueDocument": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "doc_type": {
            "type": "string",
            "title": "Doc Type"
          },
          "document_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Date"
          }
        },
        "type": "object",
        "required": [
          "id",
          "doc_type",
          "document_date"
        ],
        "title": "QueueDocument"
      },
      "QueueItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "reason": {
            "type": "string",
            "enum": [
              "no_region_on_page",
              "readers_disagree",
              "conflicting_documents",
              "unknown_unit",
              "outside_assay_range",
              "implausible_date",
              "region_illegible",
              "handwritten",
              "script_not_read"
            ],
            "title": "Reason"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "analyte_code": {
            "type": "string",
            "title": "Analyte Code"
          },
          "analyte_name": {
            "type": "string",
            "title": "Analyte Name"
          },
          "value_text": {
            "type": "string",
            "title": "Value Text"
          },
          "unit_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Text"
          },
          "candidate_readings": {
            "items": {
              "$ref": "#/components/schemas/CandidateReading"
            },
            "type": "array",
            "title": "Candidate Readings"
          },
          "crop_url": {
            "type": "string",
            "title": "Crop Url"
          },
          "patient": {
            "$ref": "#/components/schemas/QueuePatient"
          },
          "document": {
            "$ref": "#/components/schemas/QueueDocument"
          }
        },
        "type": "object",
        "required": [
          "id",
          "reason",
          "created_at",
          "analyte_code",
          "analyte_name",
          "value_text",
          "unit_text",
          "candidate_readings",
          "crop_url",
          "patient",
          "document"
        ],
        "title": "QueueItem",
        "description": "One open item. The value is shown as read, next to the crop it came from."
      },
      "QueueList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/QueueItem"
            },
            "type": "array",
            "title": "Items"
          },
          "open_count": {
            "type": "integer",
            "title": "Open Count"
          }
        },
        "type": "object",
        "required": [
          "items",
          "open_count"
        ],
        "title": "QueueList"
      },
      "QueuePatient": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "registration_no": {
            "type": "string",
            "title": "Registration No"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "registration_no",
          "full_name"
        ],
        "title": "QueuePatient"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
