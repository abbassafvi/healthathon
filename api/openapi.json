          "patient",
          "document",
          "provenance_kind",
          "page",
          "box",
          "located_by_text",
          "entered_by_name",
          "reader_name",
          "reader_version",
          "history"
        ],
        "title": "Trace"
      },
      "TraceHistory": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "accepted",
              "confirmed",
              "corrected"
            ],
            "title": "Kind"
          },
          "actor_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Name"
          },
          "at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "At"
          },
          "original_value_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
