              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PatientSummary"
                  },
                  "type": "array",
                  "title": "Response List Patients Api Patients Get"
                }
              }
            }
          }
        }
      }
    },
