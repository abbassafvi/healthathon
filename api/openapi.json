            "type": "string",
            "enum": [
              "source_document",
              "register_transcription",
              "clinician_entered",
              "patient_reported"
            ],
            "title": "Provenance Kind"
          },
          "page": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TracePage"
              },
              {
                "type": "null"
              }
            ]
          },
          "box": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Box"
              },
              {
                "type": "null"
              }
            ]
          },
          "located_by_text": {
            "type": "boolean",
            "title": "Located By Text"
          },
          "entered_by_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entered By Name"
          },
          "reader_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reader Name"
          },
          "reader_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reader Version"
          },
