          },
          "width_px": {
            "type": "integer",
            "title": "Width Px"
          },
          "height_px": {
            "type": "integer",
            "title": "Height Px"
          }
        },
        "type": "object",
        "required": [
          "url",
          "page_no",
          "page_count",
          "width_px",
          "height_px"
        ],
        "title": "TracePage"
      },
      "ValidationError": {
        "properties": {
