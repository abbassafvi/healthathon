            "title": "Reason"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "analyte_code": {
            "type": "string",
            "title": "Analyte Code"
          },
          "analyte_name": {
            "type": "string",
            "title": "Analyte Name"
          },
          "value_text": {
            "type": "string",
            "title": "Value Text"
          },
          "unit_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Text"
          },
          "candidate_readings": {
            "items": {
              "$ref": "#/components/schemas/CandidateReading"
            },
            "type": "array",
            "title": "Candidate Readings"
          },
          "crop_url": {
            "type": "string",
            "title": "Crop Url"
          },
          "patient": {
            "$ref": "#/components/schemas/QueuePatient"
          },
          "document": {
            "$ref": "#/components/schemas/QueueDocument"
          }
        },
        "type": "object",
        "required": [
          "id",
          "reason",
          "created_at",
          "analyte_code",
          "analyte_name",
          "value_text",
          "unit_text",
          "candidate_readings",
          "crop_url",
          "patient",
          "document"
        ],
        "title": "QueueItem",
        "description": "One open item. The value is shown as read, next to the crop it came from."
      },
      "QueueList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/QueueItem"
            },
            "type": "array",
            "title": "Items"
          },
          "open_count": {
            "type": "integer",
            "title": "Open Count"
          }
        },
        "type": "object",
        "required": [
          "items",
          "open_count"
        ],
        "title": "QueueList"
      },
      "QueuePatient": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
